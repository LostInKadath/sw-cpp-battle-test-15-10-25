{
    "version": 6,
    "configurePresets": [
        {
            "name": "clang",
            "displayName": "Clang",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/.build/clang",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ]
}